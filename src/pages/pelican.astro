---
import Layout from '../layouts/Layout.astro';
import PelicanMethod from '../components/PelicanMethod.astro';
import { catalog } from '../lib/catalog';
import { defaultPelicanFilters, getPelicanRows, pelicanSchema } from '../lib/pelican';
import { renderPelicanLeaders, renderPelicanTiers } from '../lib/pelican-render';
import { mark, pathFor } from '../lib/render';
import data from '../data/pelican.json';
import '../styles/pelican.css';

const base = import.meta.env.BASE_URL;
const board = pelicanSchema.parse(data);
const rows = getPelicanRows(board, catalog, defaultPelicanFilters);
const providers = catalog.providers;
---
<Layout title="鹈鹕测试榜 · 源宝模型排行榜" description="鹈鹕测试，从夯到拉排名。了解源宝鹈鹕送宝挑战的统一提示词与评分规则，等待首批真实作品，仅供娱乐。">
  <main id="main" class="page-shell pelican-page" data-base={base}>
    <section class="page-intro" aria-labelledby="page-title">
      <div class="intro-copy"><h1 id="page-title">鹈鹕测试，<span>从夯到拉排名</span></h1><p>仅供娱乐</p></div>
      <div class="provider-gallery" aria-label="鹈鹕测试榜模型厂商">{providers.map(provider => <a class="provider-gallery-item" data-pelican-provider={provider.id} href={`${pathFor(base, 'pelican/')}?providers=${provider.id}#ranking-title`} aria-label={`查看${provider.shortName}鹈鹕测试`} title={provider.name}><Fragment set:html={mark(catalog, provider.id, base)} /><span class="provider-tooltip" aria-hidden="true">{provider.shortName}</span></a>)}</div>
    </section>
    <section id="pelican-leaders" class="champions" aria-label="当前筛选的前三名模型" set:html={renderPelicanLeaders(rows, catalog, base, board.entries.length > 0)} />
    <div class="board-layout">
      <aside class="filters-sidebar" aria-label="筛选鹈鹕测试榜">
        <details id="pelican-filters" open>
          <summary class="filter-summary"><span>筛选模型</span><span class="filter-expand">展开 / 收起</span></summary>
          <div class="filter-body">
            <div class="filter-heading"><button type="button" class="text-button" id="pelican-reset">重置</button></div>
            <label class="search-box"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg><input id="pelican-search" type="search" aria-label="搜索模型或厂商" placeholder="搜索模型或厂商" maxlength="100" /></label>
            <fieldset class="provider-filter"><legend>主流厂商 <span>{providers.length}</span></legend>
              <label class="checkbox-row all-providers"><input type="checkbox" id="pelican-all" checked /><span>全部厂商</span><span class="filter-count">{rows.length}</span></label>
              {providers.map(provider => <label class="checkbox-row"><input type="checkbox" name="pelican-provider" value={provider.id} /><Fragment set:html={mark(catalog, provider.id, base)} /><span>{provider.shortName}</span><span class="filter-count">{board.entries.filter(entry => entry.providerId === provider.id).length}</span></label>)}
            </fieldset>
          </div>
        </details>
      </aside>
      <section class="ranking-panel pelican-board" aria-labelledby="ranking-title">
        <div class="ranking-header">
          <h2 id="ranking-title"><span id="pelican-board-title">鹈鹕测试榜</span> <span class="count-pill" id="pelican-count">{rows.length}</span></h2>
          <button id="pelican-share" class="outline-button" type="button"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M14 5h5v5M19 5l-9 9M11 5H5v14h14v-6"/></svg>分享当前榜单</button>
        </div>
        <div class="ranking-controls pelican-controls"><span class="pelican-pending" hidden={board.entries.length > 0}>等待首批测试结果</span><a class="pelican-method-link" data-pelican-method-link href="#pelican-method" aria-controls="pelican-method">测试与评分说明</a><label class="sort-control" for="pelican-order"><select id="pelican-order" aria-label="档位排序方向"><option value="desc">从夯到拉</option><option value="asc">从拉到夯</option></select></label></div>
        <div id="pelican-list">
          <div class="pelican-column-head" aria-hidden="true"><span>档位</span><span>模型</span><span>测试作品 · GIF</span></div>
          <div class="pelican-tiers" id="pelican-tiers" data-order="desc" set:html={renderPelicanTiers(rows, catalog, base, defaultPelicanFilters.order)} />
        </div>
        <div id="pelican-empty" class="empty-state" hidden><div class="empty-icon" aria-hidden="true">⌕</div><h3>没有找到符合条件的模型</h3><p>{board.entries.length ? '试试其他模型名称，或减少筛选条件。' : '当前尚未录入测试结果，收到测试表格后会更新。'}</p><button type="button" class="outline-button" id="pelican-empty-reset">清除筛选</button></div>
        <p class="sr-only" id="pelican-summary" role="status" aria-live="polite">显示 {rows.length} 条模型测试结果</p>
        <PelicanMethod />
      </section>
    </div>
    <noscript><p class="data-footnote">当前显示默认鹈鹕测试榜。启用 JavaScript 后可使用搜索、筛选和排序。</p></noscript>
  </main>
  <div id="pelican-toast" class="toast" role="status" aria-live="polite" hidden></div>
  <dialog id="pelican-share-dialog"><div class="dialog-heading"><h2>分享当前榜单</h2><button id="pelican-close-share" type="button" aria-label="关闭分享窗口">×</button></div><p>复制下方链接，筛选条件和排序方向将一并保留。</p><input id="pelican-share-url" type="text" readonly aria-label="当前榜单分享链接" /><button id="pelican-select-share" class="primary-button" type="button">选中链接</button></dialog>
</Layout>
<script>
  import '../scripts/pelican';
</script>
