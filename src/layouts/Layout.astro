---
import '../styles/global.css';
import '../styles/design.css';
import CommunityFooter from '../components/CommunityFooter.astro';
import { pathFor } from '../lib/render';
interface Props { title?: string; description?: string }
const { title = '价格排行榜 · 源宝模型排行榜', description = '比较主流 AI 模型的官方 API 价格、任务成本与性能，关注源宝的大模型科目三。让每个人都用得上、用得起 AI。' } = Astro.props;
const base = import.meta.env.BASE_URL;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="源宝模型排行榜" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#f5f5f7" />
    <link rel="icon" type="image/svg+xml" href={pathFor(base, 'favicon.svg')} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">跳到主要内容</a>
    <header class="site-header">
      <div class="header-inner">
        <div class="wordmark"><a class="brand-avatar-link" href="https://space.bilibili.com/38061207" target="_blank" rel="noopener noreferrer" aria-label="访问源宝的 B 站主页（新窗口打开）" title="源宝的 B 站主页"><img class="brand-avatar" src={pathFor(base, 'gityuanbao-avatar.jpg')} alt="" width="34" height="34" /></a><span>源宝模型排行榜</span></div>
        <nav aria-label="主导航"><a class:list={{ active: Astro.url.pathname === pathFor(base) }} aria-current={Astro.url.pathname === pathFor(base) ? 'page' : undefined} href={pathFor(base)}>价格排行榜</a><a class:list={{ active: Astro.url.pathname === pathFor(base, 'performance/') }} aria-current={Astro.url.pathname === pathFor(base, 'performance/') ? 'page' : undefined} href={pathFor(base, 'performance/')}>性能排行榜</a><a class:list={{ active: Astro.url.pathname === pathFor(base, 'pelican/') }} aria-current={Astro.url.pathname === pathFor(base, 'pelican/') ? 'page' : undefined} href={pathFor(base, 'pelican/')}>大模型科目三</a></nav>
      </div>
    </header>
    <slot />
    <CommunityFooter />
  </body>
</html>
<script>
  import '../scripts/motion';
</script>
